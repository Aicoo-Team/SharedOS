{
  "name": "@sharedos/runtime",
  "version": "0.1.0-alpha.0",
  "description": "Bounded one-turn execution runtime for SharedOS",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aicoo-Team/SharedOS.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@sharedos/contracts": "workspace:*",
    "@sharedos/core": "workspace:*"
  }
}
