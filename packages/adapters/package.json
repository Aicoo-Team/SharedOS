{
  "name": "@aicoo/sharedos-adapters",
  "version": "0.1.0-alpha.2",
  "description": "Codex, Claude Code, DeepSeek Harness, and Pi runtime adapters for SharedOS",
  "license": "Apache-2.0",
  "keywords": [
    "agents",
    "adapter",
    "claude-code",
    "codex",
    "deepseek",
    "pi",
    "runtime"
  ],
  "homepage": "https://www.aicoo.io",
  "bugs": {
    "email": "founders@aicoo.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aicoo-Team/SharedOS.git",
    "directory": "packages/adapters"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "dependencies": {
    "@aicoo/sharedos-contracts": "workspace:*",
    "@aicoo/sharedos-runtime": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aicoo/sharedos-core": "workspace:*",
    "@aicoo/sharedos-testkit": "workspace:*"
  }
}
