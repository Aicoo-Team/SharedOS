{
  "name": "sharedos",
  "version": "0.1.0-alpha.3",
  "description": "Permission-controlled state and delegation kernel with pluggable agent runtimes",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/clean-generated.mjs && tsc -b --force && node scripts/check-generated.mjs",
    "clean": "node scripts/clean-generated.mjs",
    "docs:api": "pnpm build && typedoc",
    "docs:api:check": "node scripts/check-api-docs.mjs",
    "conformance": "node scripts/conformance.mjs",
    "conformance:check": "node scripts/conformance.mjs --check --strict",
    "conformance:mcp": "node scripts/mcp-conformance.mjs",
    "conformance:native": "node scripts/native-conformance.mjs",
    "bench": "node scripts/bench.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:release": "node --test scripts/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "example:quickstart": "pnpm build && pnpm --filter @aicoo/sharedos-example-quickstart start",
    "example:reference-host": "pnpm build && pnpm --filter @aicoo/sharedos-example-reference-host start",
    "example:network-studio": "pnpm --filter @aicoo/sharedos-example-network-studio start",
    "pack:preview": "node scripts/pack-preview.mjs",
    "pack:check": "node scripts/pack-preview.mjs --check",
    "pack:lint": "pnpm build && node scripts/package-lint.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish",
    "release:promote-latest": "node scripts/promote-latest.mjs",
    "test:watch": "vitest",
    "example:fleet-delegation": "pnpm build && pnpm --filter @aicoo/sharedos-example-fleet-delegation start",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm test:release && pnpm docs:api:check && pnpm conformance:check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "prettier": "^3.4.2",
    "publint": "0.3.23",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
